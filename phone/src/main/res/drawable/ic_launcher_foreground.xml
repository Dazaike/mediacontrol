<?xml version="1.0" encoding="utf-8"?>
<!--
  Media player glyph: a screen outline holding a play triangle, with a seek bar and
  knob below it. Proportions traced from the source art (frame ~49% of the tile
  width) and kept inside the 66dp adaptive-icon safe circle so no mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Screen outline -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineJoin="round"
        android:pathData="M34,32.5 h41 a6,6 0 0 1 6,6 v31 a6,6 0 0 1 -6,6 h-41 a6,6 0 0 1 -6,-6 v-31 a6,6 0 0 1 6,-6 z" />
    <!-- Play triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47,42.5 L62.5,50.8 L47,59.2 Z" />
    <!-- Seek bar -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M33,69.3 H76" />
    <!-- Seek knob -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41.5,66.1 a3.2,3.2 0 1 1 0,6.4 a3.2,3.2 0 1 1 0,-6.4 z" />
</vector>

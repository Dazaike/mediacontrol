<?xml version="1.0" encoding="utf-8"?>
<!--
  Media player glyph: a screen outline holding a play triangle, with a seek bar and
  knob below it. Geometry is kept inside the 66dp adaptive-icon safe circle
  (x/y 21..87 of the 108 viewport) so no mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Screen outline -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round"
        android:pathData="M32,29 h44 a8,8 0 0 1 8,8 v34 a8,8 0 0 1 -8,8 h-44 a8,8 0 0 1 -8,-8 v-34 a8,8 0 0 1 8,-8 z" />
    <!-- Play triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47.5,40 L64,49.5 L47.5,59 Z" />
    <!-- Seek bar -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M31,71.5 H77" />
    <!-- Seek knob -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,67.3 a4.2,4.2 0 1 1 0,8.4 a4.2,4.2 0 1 1 0,-8.4 z" />
</vector>
